#!/usr/bin/env bash
# Writes the app's Secret, and the OIDC client Secret when Vault has it, from Vault.
set -euo pipefail
source "$(dirname "$0")/_common"
if [[ $# -ne 1 ]]; then
  printf 'Usage: %s\nEnvironments: %s\n' "k8s/bin/create-secrets <environment>" "$(environments | paste -sd ' ' -)" >&2
  exit 1
fi
use_environment "$1"
# The demo server's secrets, which prod shares for now.
vault_secret_key_base_path="${VAULT_SECRET_KEY_BASE_PATH:-puppet/application/semantic-search/demo/secret_key_base}"
vault_litellm_key_path="${VAULT_LITELLM_KEY_PATH:-puppet/application/semantic-search/demo/litellm_key}"
vault_oidc_client_secret_path="${VAULT_OIDC_CLIENT_SECRET_PATH:-puppet/application/semantic-search/$environment/oidc_client_secret}"

# Read everything before changing the cluster, so a Vault failure changes nothing.
secret_key_base="$(vault kv get -field=content "$vault_secret_key_base_path")"
litellm_api_key="$(vault kv get -field=content "$vault_litellm_key_path")"
oidc_client_secret=""
if ! oidc_client_secret="$(vault kv get -field=content "$vault_oidc_client_secret_path" 2>/dev/null)"; then
  oidc_client_secret=""
  printf 'No OIDC client secret at %s; skipping the %s Secret.\n' "$vault_oidc_client_secret_path" "$oidc_secret_name" >&2
fi

# Values go through file descriptors rather than arguments, so they never
# appear in the process list.
kube create secret generic "$secret_name" \
  --from-file=SECRET_KEY_BASE=<(printf '%s' "$secret_key_base") \
  --from-file=LITELLM_API_KEY=<(printf '%s' "$litellm_api_key") \
  --dry-run=client --output=yaml | kube apply -f -

# Envoy Gateway reads the client secret from the client-secret key, and picks
# up changes without a restart.
if [[ -n "$oidc_client_secret" ]]; then
  kube create secret generic "$oidc_secret_name" \
    --from-file=client-secret=<(printf '%s' "$oidc_client_secret") \
    --dry-run=client --output=yaml | kube apply -f -
fi

# Pods read Secrets only at startup.
if kube get deployment "$release" >/dev/null 2>&1; then
  printf 'Pods keep the old values until restarted: kubectl%s --namespace %s rollout restart deployment/%s\n' "${KUBE_CONTEXT:+ --context $KUBE_CONTEXT}" "$namespace" "$release"
fi
